# Local development only. Prefer: .venv/bin/python scripts/init_env.py
APP_ENV=local
APP_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
SESSION_MAX_AGE=604800
MAX_BODY_BYTES=16384
REQUEST_BODY_TIMEOUT_SECONDS=15
DATA_DIR=data
REDIS_URL=
REDIS_KEY_PREFIX=soundpick:{protection}
REDIS_TIMEOUT_SECONDS=0.1
REDIS_RETRY_SECONDS=30
APP_PORT=8000
MAX_MEDIA_BYTES=209715200
MAX_DURATION_SECONDS=1800
UPLOAD_TIMEOUT_SECONDS=300
TASK_TIMEOUT_SECONDS=600
RESULT_TTL_SECONDS=3600
MAX_RETAINED_TASKS=32
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Optional normalized JSON parsing providers. Leave blank for public-page adapters.
# GET endpoint?url=<share_url> -> {video_url, title?, author?}
DOUYIN_PARSER_URL=
HUOSHAN_PARSER_URL=
PARSER_API_TOKEN=

# HTTPS deployment: APP_ENV=production and COOKIE_SECURE=true.
# Password: 12-128 characters. Session secret: at least 32 characters.
